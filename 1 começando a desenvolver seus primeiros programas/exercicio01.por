programa{
	funcao inicio(){
		inteiro idade, idade_daqui_cinco_anos
		
		escreva("qual a sua idade: ")
		leia(idade)

		idade_daqui_cinco_anos = idade + 5
		
		escreva("sua idade daqui 5 anos será: ", idade_daqui_cinco_anos)
	}
	
}
